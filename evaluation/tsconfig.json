{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // frontend/src/crypto (imported by E5 and E7) uses the KT/byte helpers from shared/.
    "paths": { "@krypt/shared": ["../shared/src/index.ts"] }
  },
  "include": ["src", "bench", "scripts", "vite.config.ts"]
}
