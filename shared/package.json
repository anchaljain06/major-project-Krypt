{
  "name": "@krypt/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Krypt key transparency building blocks: RFC 9162 Merkle log, KT leaf encoding, signed tree heads, cosignatures, client monitoring helpers. No runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@noble/post-quantum": "^0.7.1",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
