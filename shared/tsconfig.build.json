{
  // Emits dist/ (JS + .d.ts) for the vendored witness copy
  // (witness/scripts/vendor-shared.mjs).
  // rewriteRelativeImportExtensions turns "./merkle.ts" into "./merkle.js".
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": []
  },
  "include": ["src"]
}
