# Server Configuration
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

# Auth tokens (HMAC-SHA-256). Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If unset, a random secret is generated at startup (tokens die on restart).
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=43200

# Evil relay test harness. NEVER set in production.
# Comma-separated: replay,reorder,drop,duplicate,tamper,flip_type,swap_key
# EVIL_MODE=
# EVIL_DROP_EVERY=3
# EVIL_SWAP_WITH=
