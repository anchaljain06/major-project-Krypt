# Server Configuration
FRONTEND_URL=http://localhost:5173
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

# Auth tokens (HMAC-SHA-256). Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If unset, a random secret is generated at startup (tokens die on restart).
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=43200

# Key transparency log: ML-DSA-87 tree-head signing key, standard base64 of a
# 32-byte seed (preferred) or a 4896-byte secret key. Generate with
#   npm run kt:keygen
# which also prints the public key to pin in the frontend and the witness.
# If unset, a random key is used and the log identity changes on every restart.
KT_LOG_SK=
# Minimum seconds between published tree heads (default 300). Lower only for dev.
# KT_STH_INTERVAL_SECONDS=300

# Evil relay test harness. NEVER set in production.
# Comma-separated: replay,reorder,drop,duplicate,tamper,flip_type,swap_key,
#                  kt_rogue_leaf,kt_fork,kt_rewrite
# EVIL_MODE=
# EVIL_DROP_EVERY=3
# EVIL_SWAP_WITH=
# EVIL_KT_VICTIM=          # kt_fork: name the forked view's extra leaf claims
# EVIL_FORK_UA=            # kt_fork: User-Agent substring of the client to fork
# EVIL_KT_REWRITE_INDEX=0  # kt_rewrite: which leaf to rewrite
